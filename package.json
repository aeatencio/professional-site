{
  "name": "professional-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run projection:validate && astro dev",
    "build": "npm run projection:validate && astro build && node scripts/verify-built-content.mjs",
    "preview": "astro preview",
    "check": "npm run projection:validate && astro check",
    "cv:pdf": "npm run projection:validate && node scripts/generate-cv-pdfs.mjs",
    "layout:check": "npm run build && node scripts/verify-home-overflow.mjs",
    "projection:validate": "node scripts/validate-public-projection.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astro": "^7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "6.0.3",
    "wrangler": "^4.128.0"
  }
}
