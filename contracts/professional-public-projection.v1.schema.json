{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-public-projection/v1",
  "title": "Professional public projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "publicId", "shared", "site", "cv"],
  "properties": {
    "contract": { "const": "professional-public-projection/v1" },
    "version": { "const": 1 },
    "publicId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name", "professionalIdentity", "location", "email", "links"],
      "properties": {
        "language": { "const": "en" },
        "name": { "type": "string", "minLength": 1 },
        "professionalIdentity": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["home", "experience", "background", "workingTogether", "contact"],
          "properties": {
            "home": { "$ref": "#/$defs/homeSection" },
            "experience": { "$ref": "#/$defs/experienceSection" },
            "background": { "$ref": "#/$defs/backgroundSection" },
            "workingTogether": { "$ref": "#/$defs/textSection" },
            "contact": { "$ref": "#/$defs/textSection" }
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/paragraphs" },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/textSection" }
        }
      }
    }
  },
  "$defs": {
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "homeSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs"],
      "properties": {
        "paragraphs": { "$ref": "#/$defs/paragraphs" }
      }
    },
    "textSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "$ref": "#/$defs/paragraphs" }
      }
    },
    "contentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "$ref": "#/$defs/paragraphs" }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "period", "role", "description"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "period": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "softwareDevelopment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "roles"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/role" }
        }
      }
    },
    "currentDevelopment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs", "items"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "$ref": "#/$defs/paragraphs" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentItem" }
        }
      }
    },
    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs", "softwareDevelopment", "currentDevelopment", "teaching"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "$ref": "#/$defs/paragraphs" },
        "softwareDevelopment": { "$ref": "#/$defs/softwareDevelopment" },
        "currentDevelopment": { "$ref": "#/$defs/currentDevelopment" },
        "teaching": { "$ref": "#/$defs/textSection" }
      }
    },
    "backgroundSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "items"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contentItem" }
        }
      }
    }
  }
}
