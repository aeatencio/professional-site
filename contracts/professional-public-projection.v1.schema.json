{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "professional-public-projection/v1",
  "title": "Professional public projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "publicId", "shared", "site", "cv"],
  "properties": {
    "contract": { "const": "professional-public-projection/v1" },
    "version": { "const": 1 },
    "publicId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "shared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "name", "professionalIdentity"],
      "properties": {
        "language": { "const": "en" },
        "name": { "type": "string", "minLength": 1 },
        "professionalIdentity": { "type": "string", "minLength": 1 }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "sections"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["home", "experience", "background", "workingTogether", "contact"],
          "properties": {
            "home": { "$ref": "#/$defs/homeSection" },
            "experience": { "$ref": "#/$defs/section" },
            "background": { "$ref": "#/$defs/section" },
            "workingTogether": { "$ref": "#/$defs/section" },
            "contact": { "$ref": "#/$defs/section" }
          }
        }
      }
    },
    "cv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "$ref": "#/$defs/paragraphs" },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  },
  "$defs": {
    "paragraphs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "homeSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs"],
      "properties": {
        "paragraphs": { "$ref": "#/$defs/paragraphs" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "paragraphs"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "paragraphs": { "$ref": "#/$defs/paragraphs" },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  }
}
