---
import BaseLayout from '../layouts/BaseLayout.astro';
import projection from '../../data/professional-public-projection.v1.json';

interface ContentSection {
  heading: string;
  paragraphs: string[];
  groups?: ContentSection[];
}

const { shared, site } = projection;
const { sections } = site;
const chapters: Array<{ id: string; content: ContentSection; shifted: boolean }> = [
  { id: 'experience', content: sections.experience, shifted: false },
  { id: 'background', content: sections.background, shifted: true },
  { id: 'working-together', content: sections.workingTogether, shifted: false },
  { id: 'contact', content: sections.contact, shifted: true }
];
---

<BaseLayout
  lang={shared.language}
  name={shared.name}
  title={site.title}
  description={site.description}
>
  <main id="main">
    <section id="home" class="chapter chapter--home" aria-labelledby="home-heading">
      <div class="chapter__body">
        <h1 id="home-heading">{shared.professionalIdentity}</h1>
        {sections.home.paragraphs.map((paragraph) => <p class="lede">{paragraph}</p>)}
        <p class="actions">
          <a class="action" href="#contact">Contact</a>
          <a href="#experience">Experience</a>
        </p>
      </div>
    </section>

    {chapters.map(({ id, content, shifted }) => (
      <section
        id={id}
        class:list={['chapter', { 'chapter--shift': shifted }]}
        aria-labelledby={`${id}-heading`}
      >
        <div class="chapter__body">
          <h2 id={`${id}-heading`}>{content.heading}</h2>
          {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {content.groups?.map((group) => (
            <>
              <h3>{group.heading}</h3>
              {group.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
