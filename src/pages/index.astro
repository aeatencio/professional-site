---
import BaseLayout from '../layouts/BaseLayout.astro';
import projection from '../../data/professional-public-projection.v1.json';

const { shared, site } = projection;
const { sections } = site;
---

<BaseLayout
  lang={shared.language}
  name={shared.name}
  title={site.title}
  description={site.description}
>
  <main id="main">
    <section id="home" class="chapter chapter--home" aria-labelledby="home-heading">
      <div class="chapter__body">
        <h1 id="home-heading">{shared.professionalIdentity}</h1>
        {sections.home.paragraphs.map((paragraph) => <p class="lede">{paragraph}</p>)}
        <p class="actions">
          <a class="action" href="#contact">Contact</a>
          <a href="#experience">Experience</a>
        </p>
      </div>
      <img
        class="hero-art"
        src="/images/hero/hero-art-a-transparent.png"
        alt=""
        width="1024"
        height="1536"
        decoding="async"
        fetchpriority="high"
      />
    </section>

    <section id="experience" class="chapter chapter--experience" aria-labelledby="experience-heading">
      <div class="chapter__body">
        <h2 id="experience-heading">{sections.experience.heading}</h2>
        {sections.experience.paragraphs.map((paragraph) => <p class="section-intro">{paragraph}</p>)}
      </div>
      <img
        class="chapter-art chapter-art--notebook"
        src="/images/experience/experience-notebook-transparent.png"
        alt=""
        width="1276"
        height="789"
        decoding="async"
        loading="lazy"
      />
      <div class="chapter__continue">
        <div class="experience-block">
          <h3>{sections.experience.softwareDevelopment.heading}</h3>
          <div class="role-list">
            {sections.experience.softwareDevelopment.roles.map((role) => (
              <article class="role">
                <header class="role__header">
                  <div>
                    <h4>{role.organization}</h4>
                    <p class="role__title">{role.role}</p>
                  </div>
                  <p class="role__period">{role.period}</p>
                </header>
                <p>{role.description}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="experience-block">
          <h3>{sections.experience.currentDevelopment.heading}</h3>
          {sections.experience.currentDevelopment.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <div class="content-grid">
            {sections.experience.currentDevelopment.items.map((item) => (
              <article class="content-item">
                <h4>{item.heading}</h4>
                {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </article>
            ))}
          </div>
        </div>

        <div class="experience-block">
          <h3>{sections.experience.teaching.heading}</h3>
          {sections.experience.teaching.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section id="background" class="chapter chapter--background chapter--shift" aria-labelledby="background-heading">
      <div class="chapter__body chapter__body--wide">
        <h2 id="background-heading">{sections.background.heading}</h2>
        <div class="content-grid content-grid--background">
          {sections.background.items.map((item) => (
            <article class="content-item">
              <h3>{item.heading}</h3>
              {item.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </article>
          ))}
          <img
            class="chapter-art chapter-art--map"
            src="/images/background/background-folded-map-transparent.png"
            alt=""
            width="1371"
            height="696"
            decoding="async"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section id="working-together" class="chapter chapter--working" aria-labelledby="working-together-heading">
      <div class="chapter__body">
        <h2 id="working-together-heading">{sections.workingTogether.heading}</h2>
        {sections.workingTogether.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <img
        class="chapter-art chapter-art--folder"
        src="/images/working-together/working-together-folder-transparent.png"
        alt=""
        width="1130"
        height="1032"
        decoding="async"
        loading="lazy"
      />
    </section>

    <section id="contact" class="chapter chapter--contact" aria-labelledby="contact-heading">
      <div class="chapter__body">
        <h2 id="contact-heading">{sections.contact.heading}</h2>
        {sections.contact.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <p class="contact-location">{shared.location}</p>
        <ul class="contact-links">
          <li><a href={`mailto:${shared.email}`}>{shared.email}</a></li>
          {shared.links.map((link) => (
            <li><a href={link.url} rel="me">{link.label}</a></li>
          ))}
        </ul>
      </div>
      <img
        class="chapter-art chapter-art--correspondence"
        src="/images/contact/contact-correspondence-transparent.png"
        alt=""
        width="1077"
        height="850"
        decoding="async"
        loading="lazy"
      />
    </section>
  </main>
</BaseLayout>
