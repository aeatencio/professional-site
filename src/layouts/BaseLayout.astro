---
import '../styles/global.css';
import '../styles/site-shell.css';
import PrimaryNav from '../components/PrimaryNav.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { absoluteUrl, LOCALIZED_PATHS } from '../../lib/site-identity.mjs';
import { SOCIAL_CARD } from '../../lib/social-card.mjs';
import type { HomeCopy, HomeLanguage } from '../../lib/home-copy';

interface Props {
  title: string;
  description: string;
  lang: HomeLanguage;
  name: string;
  canonicalPath: string;
  skipHref?: string;
  bodyClass?: string;
  shell?: 'site' | 'document';
  ogType?: 'website' | 'profile';
  socialCardAlt?: string;
  jsonLd?: Record<string, unknown>;
  alternates?: Record<HomeLanguage, string>;
  labels?: { skip: string; language: string };
  homeCopy?: HomeCopy;
}

const {
  title,
  description,
  lang,
  name,
  canonicalPath,
  skipHref = '#main',
  bodyClass,
  shell = 'site',
  ogType = 'website',
  socialCardAlt,
  jsonLd,
  alternates,
  homeCopy,
  labels = homeCopy?.ui
} = Astro.props;
const isDocumentShell = shell === 'document';
const isHome = Boolean(homeCopy) || (Astro.url.pathname.replace(/\/$/, '') || '/') === '/';
const homeHref = isHome ? '#home' : LOCALIZED_PATHS.home[lang];
const IdentityTag = isHome ? 'h1' : 'p';
if (!Astro.site) {
  throw new Error('A site URL is required to emit canonical metadata');
}
const canonicalUrl = absoluteUrl(canonicalPath, Astro.site);
const sitemapUrl = absoluteUrl('/sitemap-index.xml', Astro.site);
/**
 * A page opts into the social card by passing its alt text; the alt describes
 * the image, so it comes from the projection through the page rather than from
 * copy hardcoded here. Pages without it keep the small summary card instead of
 * promising a large image they do not provide.
 *
 * Today only the Home opts in. The CV routes stay on the summary card because
 * their built `<head>` feeds the printable-CV fingerprint, so metadata that
 * never reaches paper would force a regeneration of the versioned PDFs.
 */
const hasSocialCard = Boolean(socialCardAlt);
const ogLocale = { en: 'en_US', es: 'es_AR' } as const;
const socialCardUrl = absoluteUrl(SOCIAL_CARD.href, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={sitemapUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    {hasSocialCard ? (
      <Fragment>
        <meta property="og:site_name" content={name} />
        <meta property="og:image" content={socialCardUrl} />
        <meta property="og:image:type" content={SOCIAL_CARD.type} />
        <meta property="og:image:width" content={String(SOCIAL_CARD.width)} />
        <meta property="og:image:height" content={String(SOCIAL_CARD.height)} />
        <meta property="og:image:alt" content={socialCardAlt} />
        <meta name="twitter:card" content="summary_large_image" />
      </Fragment>
    ) : (
      <meta name="twitter:card" content="summary" />
    )}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {hasSocialCard ? (
      <Fragment>
        <meta name="twitter:image" content={socialCardUrl} />
        <meta name="twitter:image:alt" content={socialCardAlt} />
      </Fragment>
    ) : null}
    {jsonLd ? (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {alternates ? (
      <Fragment>
        <link rel="alternate" hreflang="en" href={absoluteUrl(alternates.en, Astro.site)} />
        <link rel="alternate" hreflang="es" href={absoluteUrl(alternates.es, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.en, Astro.site)} />
        <meta property="og:locale" content={ogLocale[lang]} />
        <meta property="og:locale:alternate" content={ogLocale[lang === 'es' ? 'en' : 'es']} />
      </Fragment>
    ) : null}
    <slot name="head" />
  </head>
  <body class={bodyClass} data-shell={shell}>
    <a class="skip-link" href={skipHref}>{labels?.skip ?? 'Skip to content'}</a>
    <div class="page">
      <header class="site-header" data-directional-header={isDocumentShell ? undefined : true}>
        <div class="site-header__inner">
          <IdentityTag class="identity" id={isHome ? 'site-identity' : undefined}>
            <a href={homeHref}>{name}</a>
            <span class="identity-mark" aria-hidden="true"></span>
          </IdentityTag>
          {isDocumentShell
            ? alternates && labels ? <LanguageSwitch language={lang} label={labels.language} alternates={alternates} /> : null
            : <PrimaryNav copy={homeCopy} />}
        </div>
      </header>
      <slot />
      {isDocumentShell ? null : (
        <footer class="site-footer">
          <p>{name}</p>
          <a href={LOCALIZED_PATHS.cv[lang]}>{homeCopy?.ui.footerCv ?? 'CV'}</a>
        </footer>
      )}
    </div>
    <script>
      const header = document.querySelector<HTMLElement>('[data-directional-header]');

      if (header) {
        const TOP_TOLERANCE = 24;
        const HIDE_DISTANCE = 16;
        const REVEAL_DISTANCE = 8;
        let lastScrollY = Math.max(window.scrollY, 0);
        let directionalDistance = 0;
        let framePending = false;
        let pointerActive = false;

        const hasVisibleKeyboardFocus = () => {
          const active = document.activeElement;
          return active instanceof HTMLElement
            && header.contains(active)
            && active.matches(':focus-visible');
        };

        const isPinned = () => pointerActive
          || Boolean(header.querySelector('details[open]'))
          || hasVisibleKeyboardFocus();

        const showHeader = () => header.classList.remove('site-header--hidden');

        const resetDirection = () => {
          directionalDistance = 0;
        };

        const updateHeader = () => {
          framePending = false;
          const nextScrollY = Math.max(window.scrollY, 0);
          const delta = nextScrollY - lastScrollY;
          lastScrollY = nextScrollY;

          if (nextScrollY <= TOP_TOLERANCE || isPinned()) {
            showHeader();
            resetDirection();
            return;
          }

          if (delta === 0) return;

          const directionChanged = (delta > 0 && directionalDistance < 0)
            || (delta < 0 && directionalDistance > 0);
          if (directionChanged) {
            directionalDistance = 0;
          }
          directionalDistance += delta;

          if (directionalDistance >= HIDE_DISTANCE) {
            header.classList.add('site-header--hidden');
            directionalDistance = 0;
          } else if (directionalDistance <= -REVEAL_DISTANCE) {
            showHeader();
            directionalDistance = 0;
          }
        };

        const queueUpdate = () => {
          if (framePending) return;
          framePending = true;
          window.requestAnimationFrame(updateHeader);
        };

        const revealAndReset = () => {
          showHeader();
          lastScrollY = Math.max(window.scrollY, 0);
          resetDirection();
        };

        const revealImmediately = () => {
          header.classList.add('site-header--instant');
          revealAndReset();
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => {
              header.classList.remove('site-header--instant');
            });
          });
        };

        window.addEventListener('scroll', queueUpdate, { passive: true });
        window.addEventListener('hashchange', () => {
          window.requestAnimationFrame(revealAndReset);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Tab' && header.classList.contains('site-header--hidden')) {
            revealImmediately();
          }
        });

        header.addEventListener('focusin', (event) => {
          if (event.target instanceof HTMLElement && event.target.matches(':focus-visible')) {
            revealImmediately();
          }
        });

        header.addEventListener('pointerdown', () => {
          pointerActive = true;
          revealAndReset();
        });

        const endPointerInteraction = () => {
          pointerActive = false;
          lastScrollY = Math.max(window.scrollY, 0);
          resetDirection();
        };

        window.addEventListener('pointerup', endPointerInteraction);
        window.addEventListener('pointercancel', endPointerInteraction);

        header.addEventListener('toggle', revealAndReset, true);
      }
    </script>
  </body>
</html>
