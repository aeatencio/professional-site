---
import BaseLayout from './BaseLayout.astro';
import '../styles/cv.css';
import { LOCALIZED_PATHS } from '../../lib/site-identity.mjs';
import type { CvCopy } from '../../lib/cv-copy';

interface Props {
  copy: CvCopy;
  format?: 'a4' | 'letter';
}

const { copy, format = 'a4' } = Astro.props;
const { shared, cv } = copy;
const pageSize = format === 'letter' ? '215.9mm 279.4mm' : '210mm 297mm';
---

<BaseLayout
  title={`${shared.name} — ${cv.title}`}
  description={cv.profile.text}
  lang={copy.language}
  name={shared.name}
  canonicalPath={copy.path}
  alternates={LOCALIZED_PATHS.cv}
  labels={copy.ui}
  skipHref="#cv-main"
  shell="document"
>
  <Fragment slot="head" set:html={`<style>@page { size: ${pageSize}; margin: 0; }</style>`} />
  <div class="cv-document" data-cv-format={format}>
    <slot />
  </div>
</BaseLayout>
