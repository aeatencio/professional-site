---
import BaseLayout from './BaseLayout.astro';
import '../styles/cv.css';
import { CV_PATH } from '../../lib/site-identity.mjs';

interface Props {
  title: string;
  description: string;
  lang: string;
  name: string;
  format?: 'a4' | 'letter';
}

const { title, description, lang, name, format = 'a4' } = Astro.props;
const pageSize = format === 'letter' ? '215.9mm 279.4mm' : '210mm 297mm';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  name={name}
  canonicalPath={CV_PATH}
  skipHref="#cv-main"
>
  <Fragment slot="head" set:html={`<style>@page { size: ${pageSize}; margin: 0; }</style>`} />
  <div class="cv-document" data-cv-format={format}>
    <slot />
  </div>
</BaseLayout>
