---
import BaseLayout from './BaseLayout.astro';
import CvChrome from '../components/CvChrome.astro';
import '../styles/cv.css';

interface Props {
  title: string;
  description: string;
  lang: string;
  name: string;
  format?: 'a4' | 'letter';
}

const { title, description, lang, name, format = 'a4' } = Astro.props;
const pageSize = format === 'letter' ? '215.9mm 279.4mm' : '210mm 297mm';
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  name={name}
  skipHref="#cv-main"
  bodyClass="cv-document"
  cvFormat={format}
>
  <Fragment slot="head" set:html={`<style>@page { size: ${pageSize}; margin: 0; }</style>`} />
  <CvChrome slot="contextual" format={format} />
  <slot />
</BaseLayout>
