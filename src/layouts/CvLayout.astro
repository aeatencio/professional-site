---
import BaseLayout from './BaseLayout.astro';
import '../styles/cv.css';
import { PUBLIC_SITE_ORIGIN } from '../../lib/cv-pdf.mjs';

interface Props {
  title: string;
  description: string;
  lang: string;
  name: string;
  format?: 'a4' | 'letter';
}

const { title, description, lang, name, format = 'a4' } = Astro.props;
const pageSize = format === 'letter' ? '215.9mm 279.4mm' : '210mm 297mm';
const canonicalHref = `${PUBLIC_SITE_ORIGIN}/cv/`;
const headMarkup = format === 'letter'
  ? `<link rel="canonical" href="${canonicalHref}" /><style>@page { size: ${pageSize}; margin: 0; }</style>`
  : `<style>@page { size: ${pageSize}; margin: 0; }</style>`;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  name={name}
  skipHref="#cv-main"
>
  <Fragment slot="head" set:html={headMarkup} />
  <div class="cv-document" data-cv-format={format}>
    <slot />
  </div>
</BaseLayout>
