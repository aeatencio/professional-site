---
import projection from '../../data/professional-public-projection.v1.json';
import CvActions from './CvActions.astro';

const { shared, cv } = projection;
const siteUrl = Astro.site ? Astro.site.origin : '';

function visibleProfileUrl(url: string) {
  return url.replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/$/, '');
}
---

<main class="cv-page" id="cv-main">
  <header class="cv-header">
    <div class="cv-masthead">
      <h1>{shared.name}</h1>
      <p class="cv-identity">{cv.title}</p>
      <CvActions />
    </div>
    <address class="cv-contact">
      <span>{shared.location}</span>
      <a href={`mailto:${shared.email}`}>{shared.email}</a>
      {siteUrl ? (
        <a href={siteUrl} rel="me" aria-label="Website">{visibleProfileUrl(siteUrl)}</a>
      ) : null}
      {shared.links.map((link) => (
        <a href={link.url} rel="me" aria-label={link.label}>{visibleProfileUrl(link.url)}</a>
      ))}
    </address>
  </header>

  <div class="cv-body">
    <section class="cv-profile" aria-labelledby="cv-profile-heading">
      <h2 id="cv-profile-heading">
        <span class="cv-heading-text">{cv.profile.heading}</span>
        <span class="cv-heading-rule" aria-hidden="true"></span>
      </h2>
      <p>{cv.profile.text}</p>
    </section>

    <section class="cv-technical" aria-labelledby="cv-technical-heading">
      <h2 id="cv-technical-heading">
        <span class="cv-heading-text">{cv.technicalBackground.heading}</span>
        <span class="cv-heading-rule" aria-hidden="true"></span>
      </h2>
      <div class="cv-technical-group">
        <h3>{cv.technicalBackground.professionalExperience.heading}</h3>
        <p>{cv.technicalBackground.professionalExperience.items.join(', ')}.</p>
      </div>
      <div class="cv-technical-group">
        <h3>{cv.technicalBackground.currentPractice.heading}</h3>
        <p>{cv.technicalBackground.currentPractice.items.join(', ')}.</p>
      </div>
    </section>

    <div class="cv-primary">
      <section aria-labelledby="cv-experience-heading">
        <h2 id="cv-experience-heading">
          <span class="cv-heading-text">{cv.softwareExperience.heading}</span>
          <span class="cv-heading-rule" aria-hidden="true"></span>
        </h2>
        <div class="cv-roles">
          {cv.softwareExperience.roles.map((role) => (
            <article class="cv-role">
              <header>
                <div>
                  <h3>{role.organization}</h3>
                  <p class="cv-role-title">{role.role}</p>
                </div>
                <p class="cv-period">{role.period}</p>
              </header>
              <p>{role.summary}</p>
              {role.highlights ? (
                <ul class="cv-highlights">
                  {role.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
              ) : null}
              <p class="cv-technologies">
                <span class="cv-context-label">Context:</span> {role.technologies.join(', ')}
              </p>
            </article>
          ))}
        </div>
      </section>
    </div>

    <div class="cv-secondary">
      <section aria-labelledby="cv-teaching-heading">
        <h2 id="cv-teaching-heading">
          <span class="cv-heading-text">{cv.teaching.heading}</span>
          <span class="cv-heading-rule" aria-hidden="true"></span>
        </h2>
        <p>{cv.teaching.text}</p>
      </section>

      <section aria-labelledby="cv-education-heading">
        <h2 id="cv-education-heading">
          <span class="cv-heading-text">{cv.education.heading}</span>
          <span class="cv-heading-rule" aria-hidden="true"></span>
        </h2>
        <div class="cv-education-list">
          {cv.education.items.map((item) => (
            <article>
              <h3>{item.institution}</h3>
              <p>{item.qualification}</p>
              <p class="cv-period">
                {item.period}{'detail' in item ? ` · ${item.detail}` : ''}
              </p>
            </article>
          ))}
        </div>
      </section>

      <section class="cv-current-development" aria-labelledby="cv-current-development-heading">
        <h2 id="cv-current-development-heading">
          <span class="cv-heading-text">{cv.currentDevelopment.heading}</span>
          <span class="cv-heading-rule" aria-hidden="true"></span>
        </h2>
        <p>{cv.currentDevelopment.text}</p>
      </section>

      <section aria-labelledby="cv-languages-heading">
        <h2 id="cv-languages-heading">
          <span class="cv-heading-text">{cv.languages.heading}</span>
          <span class="cv-heading-rule" aria-hidden="true"></span>
        </h2>
        <dl class="cv-languages">
          {cv.languages.items.map((item) => (
            <div>
              <dt>{item.language}</dt>
              <dd>{item.proficiency}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </div>
</main>
