---
import { CV_PDF } from '../../lib/cv-pdf.mjs';

interface Props {
  format: 'a4' | 'letter';
}

const { format } = Astro.props;
const pdf = CV_PDF[format];
---

<header class="cv-chrome">
  <nav class="cv-chrome__nav" aria-label="CV">
    <a class="cv-chrome__back" href="/">Back to site</a>
    <ul class="cv-chrome__actions">
      <li>
        <a href={CV_PDF.a4.route} aria-current={format === 'a4' ? 'page' : undefined}>A4</a>
      </li>
      <li>
        <a href={CV_PDF.letter.route} aria-current={format === 'letter' ? 'page' : undefined}>US Letter</a>
      </li>
      <li>
        <a
          href={pdf.href}
          download={pdf.download}
          type="application/pdf"
          aria-label={format === 'letter' ? 'Download US Letter PDF' : 'Download A4 PDF'}
        >Download PDF</a>
      </li>
    </ul>
  </nav>
</header>
