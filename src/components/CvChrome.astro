---
import { CV_PDF } from '../../lib/cv-pdf.mjs';

interface Props {
  format: 'a4' | 'letter';
}

const { format } = Astro.props;
const pdf = CV_PDF[format];
---

<div class="cv-chrome">
  <nav class="cv-chrome__nav" aria-label="CV">
    <a class="cv-chrome__back" href="/" aria-label="Back to site">
      <svg class="cv-chrome__back-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.15" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
    <ul class="cv-chrome__actions">
      <li>
        <a href={CV_PDF.a4.route} aria-current={format === 'a4' ? 'page' : undefined}>A4</a>
      </li>
      <li>
        <a href={CV_PDF.letter.route} aria-current={format === 'letter' ? 'page' : undefined}>US Letter</a>
      </li>
      <li>
        <a
          href={pdf.href}
          download={pdf.download}
          type="application/pdf"
          aria-label={format === 'letter' ? 'Download US Letter PDF' : 'Download A4 PDF'}
        >Download PDF</a>
      </li>
    </ul>
    <details class="cv-chrome__download">
      <summary>Download PDF</summary>
      <ul class="cv-chrome__download-options">
        <li>
          <a
            href={CV_PDF.a4.href}
            download={CV_PDF.a4.download}
            type="application/pdf"
            aria-label="Download A4 PDF"
          >A4</a>
        </li>
        <li>
          <a
            href={CV_PDF.letter.href}
            download={CV_PDF.letter.download}
            type="application/pdf"
            aria-label="Download US Letter PDF"
          >US Letter</a>
        </li>
      </ul>
    </details>
  </nav>
</div>

<script>
  const download = document.querySelector<HTMLDetailsElement>('.cv-chrome__download');
  const summary = download?.querySelector<HTMLElement>(':scope > summary');

  if (download && summary) {
    download.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !download.open) return;

      event.preventDefault();
      event.stopPropagation();
      download.open = false;
      summary.focus();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (download.open && !download.contains(event.target)) {
        download.open = false;
      }
    });
  }
</script>
