---
/**
 * Static decorative cable for the Home continuous-surface prototype.
 * Geometry is presentation-only and owned here, not by the public projection.
 * Two SVG layers enable real occlusion: behind illustrations, then ahead of them.
 * Coordinates are percentages of `.home-surface` (viewBox 0 0 100 100).
 * Desktop-first: this iteration does not tune a tablet or mobile route.
 */
---

<div class="journey-cable" aria-hidden="true">
  <svg
    class="journey-cable__svg journey-cable__svg--behind"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    focusable="false"
  >
    <g class="cable-paths cable-paths--desktop">
      <!-- Notebook: ahead stops before the object; this stretch stays under the paper mass -->
      <path
        class="journey-cable__stroke"
        d="M 47.0 18.5
           C 42.5 20.4, 56.0 22.6, 68.5 24.4
           C 74.0 25.4, 76.8 26.4, 77.4 27.2"
      />
      <!-- Map: long hide, leftward dive, exit displaced on the lower right -->
      <path
        class="journey-cable__stroke"
        d="M 44.0 65.4
           C 30.0 67.2, 14.5 69.0, 11.8 70.8
           C 10.5 72.2, 26.0 73.4, 48.0 74.0
           C 60.0 74.4, 67.0 75.0, 69.5 75.6"
      />
      <!-- Folder: short corner hide -->
      <path
        class="journey-cable__stroke"
        d="M 50.8 87.6
           C 54.8 88.2, 57.2 89.0, 55.4 89.7
           C 53.2 90.15, 50.6 90.2, 48.8 90.25"
      />
    </g>
  </svg>

  <svg
    class="journey-cable__svg journey-cable__svg--ahead"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    focusable="false"
  >
    <g class="cable-paths cable-paths--desktop">
      <!-- Hero: slack curve from the laptop, not a taut diagonal -->
      <path
        class="journey-cable__stroke"
        d="M 85.8 6.4
           C 83.5 10.2, 74.0 11.8, 64.5 13.4
           C 55.5 15.2, 50.0 17.2, 47.0 18.4"
      />
      <!-- After notebook: tiny slack at the object, not a gutter flourish -->
      <path
        class="journey-cable__stroke"
        d="M 77.4 27.3
           C 79.0 28.0, 79.8 29.0, 78.5 29.7
           C 77.6 30.2, 76.2 30.4, 75.0 30.35"
      />
      <!-- Approach the map from nearby; the long Experience body has no rail -->
      <path
        class="journey-cable__stroke"
        d="M 62.0 61.8
           C 56.5 63.0, 50.0 64.2, 46.0 64.8
           C 44.8 65.0, 44.2 65.1, 44.0 65.2"
      />
      <!-- After map: compact, near the working cluster / folder -->
      <path
        class="journey-cable__stroke"
        d="M 69.5 75.8
           C 66.5 79.2, 59.0 83.2, 53.2 86.2
           C 51.6 87.0, 51.0 87.3, 50.8 87.6"
      />
      <!-- Contact: short free end in the left opening, no flourish -->
      <path
        class="journey-cable__stroke"
        d="M 48.8 90.25
           C 43.0 91.4, 37.5 93.0, 33.5 94.0
           C 31.4 94.6, 31.0 95.0, 32.2 95.15"
      />
    </g>
  </svg>
</div>

<style>
  .journey-cable {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .journey-cable__svg {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    color: var(--color-cobalt);
  }

  .journey-cable__svg--behind {
    z-index: 0;
  }

  .journey-cable__svg--ahead {
    z-index: 4;
  }

  .journey-cable__stroke {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 64rem) {
    .journey-cable {
      display: none;
    }
  }
</style>
