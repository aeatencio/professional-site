---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const isCvPage = pathname === '/cv' || pathname === '/cv/letter';
const sectionHref = (hash: string) => (isHome ? hash : `/${hash}`);
const sectionItems = [
  { href: sectionHref('#experience'), label: 'Experience' },
  { href: sectionHref('#background'), label: 'Background' },
  { href: sectionHref('#working-together'), label: 'Working together' }
];
const contactHref = sectionHref('#contact');
---

<nav class="primary-nav" aria-label="Primary" data-primary-navigation>
  <ul class="primary-nav__desktop-list">
    {sectionItems.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
      </li>
    ))}
    <li>
      {isCvPage ? (
        <a href="/cv/" aria-current="page">CV</a>
      ) : (
        <a href="/cv/">CV</a>
      )}
    </li>
    <li class="primary-nav__contact"><a href={contactHref}>Contact</a></li>
  </ul>

  <details class="primary-nav__mobile" data-mobile-navigation>
    <summary><span>Menu</span></summary>
    <div class="primary-nav__mobile-panel">
      <ul class="primary-nav__mobile-list">
        {sectionItems.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          {isCvPage ? (
            <a href="/cv/" aria-current="page">CV</a>
          ) : (
            <a href="/cv/">CV</a>
          )}
        </li>
        <li class="primary-nav__mobile-contact"><a href={contactHref}>Contact</a></li>
      </ul>
    </div>
  </details>
</nav>

<script>
  const primaryNavigation = document.querySelector<HTMLElement>('[data-primary-navigation]');
  const mobileNavigation = document.querySelector<HTMLDetailsElement>('[data-mobile-navigation]');

  if (primaryNavigation && mobileNavigation) {
    const menuSummary = mobileNavigation.querySelector<HTMLElement>(':scope > summary');

    const closeMobileNavigation = (restoreFocus = false) => {
      mobileNavigation.open = false;
      if (restoreFocus) menuSummary?.focus();
    };

    const closeOutsideDisclosure = (disclosure: HTMLDetailsElement) => {
      const summary = disclosure.querySelector<HTMLElement>(':scope > summary');
      disclosure.open = false;
      if (document.activeElement !== summary && disclosure.contains(document.activeElement)) {
        summary?.focus({ preventScroll: true });
      }
    };

    mobileNavigation.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !mobileNavigation.open) return;

      event.preventDefault();
      closeMobileNavigation(true);
    });

    for (const link of mobileNavigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')) {
      link.addEventListener('click', () => {
        closeMobileNavigation();
      });
    }

    document.querySelector<HTMLAnchorElement>('.identity a[href="#home"]')?.addEventListener('click', () => {
      closeMobileNavigation();
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;

      if (mobileNavigation.open && !mobileNavigation.contains(event.target)) {
        closeOutsideDisclosure(mobileNavigation);
      }
    });
  }
</script>
